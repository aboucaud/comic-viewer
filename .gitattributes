# Fins de ligne : Windows a besoin de CRLF pour .bat/.ps1, macOS/Linux de LF.
*.bat     text eol=crlf
*.ps1     text eol=crlf
*.sh      text eol=lf
*.command text eol=lf
*.pdf     binary

# Exclus du ZIP distribué (git archive) : fichiers de développement
.github         export-ignore
.gitattributes  export-ignore
.gitignore      export-ignore
CLAUDE.md       export-ignore
